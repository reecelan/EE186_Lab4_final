// Send a null-terminated string to the terminal (ST-LINK virtual COM port)
static void uart_print(const char *s)
{
  HAL_UART_Transmit(&hlpuart1, (uint8_t *)s, (uint16_t)strlen(s), 100);
}

// Run one ADC conversion on PB1 (ADC1_IN16) and return the 12-bit result
static HAL_StatusTypeDef adc_read(uint32_t *raw)
{
  if (HAL_ADC_Start(&hadc1) != HAL_OK)                 return HAL_ERROR;  // start one conversion
  if (HAL_ADC_PollForConversion(&hadc1, 10) != HAL_OK) return HAL_ERROR;  // wait for end of conversion
  *raw = HAL_ADC_GetValue(&hadc1);                                        // 0 .. 4095
  return HAL_OK;
}

// Average several conversions to smooth out a few counts of ADC noise
static HAL_StatusTypeDef adc_read_avg(uint32_t *avg)
{
  uint32_t sum = 0, sample = 0;
  for (uint32_t i = 0; i < ADC_AVG_SAMPLES; i++)
  {
    if (adc_read(&sample) != HAL_OK) return HAL_ERROR;
    sum += sample;
  }
  *avg = sum / ADC_AVG_SAMPLES;
  return HAL_OK;
}

// Photoresistor resistance from the divider equation, solved for R_LDR.
// Circuit: 3.3 V -> 10 kOhm -> PB1 -> photoresistor -> GND
//   Vout = Vin * R_LDR / (R_LDR + R_FIXED)  ->  R_LDR = R_FIXED * Vout / (Vin - Vout)
// Using ADC counts instead of volts, the 3.3 V cancels out (the divider and the ADC
// share the same supply): R_LDR = R_FIXED * raw / (4096 - raw)
static void format_r_ldr(char *out, size_t n, uint32_t raw)
{
  if (raw >= ADC_FULL_SCALE)            // cannot happen with a 12-bit result; guards the division
  {
    snprintf(out, n, "   (dark/open)");
    return;
  }
  uint32_t r = (R_FIXED_OHM * raw) / (ADC_FULL_SCALE - raw);     // ohms
  snprintf(out, n, "%6u.%u kOhm", (unsigned)(r / 1000), (unsigned)((r % 1000) / 100));
}

// Text bar showing light level, so changes are easy to see on video.
// With the photoresistor on the bottom, MORE light gives a LOWER reading,
// so the bar is filled in proportion to (4096 - raw): brighter = longer bar.
static void make_light_bar(char *bar, uint32_t raw)
{
  uint32_t filled = ((ADC_FULL_SCALE - raw) * BAR_WIDTH) / ADC_FULL_SCALE;
  for (uint32_t i = 0; i < BAR_WIDTH; i++)
  {
    bar[i] = (i < filled) ? '#' : ' ';
  }
  bar[BAR_WIDTH] = '\0';
}
