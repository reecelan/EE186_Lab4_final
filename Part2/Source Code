/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */
  char msg[160];
  char rbuf[24];
  char bar[BAR_WIDTH + 1];
  uint32_t raw = 0;
  uint32_t mv = 0;
  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_ADC1_Init();
  MX_DAC1_Init();
  MX_LPUART1_UART_Init();
  MX_TIM6_Init();
  /* USER CODE BEGIN 2 */
  uart_print("\r\nEE186 Lab 4 Part 1: light meter on PB1 (ADC1_IN16)\r\n");
  uart_print("Circuit: 3.3 V -> 10 kOhm -> PB1 -> photoresistor -> GND\r\n");
  uart_print("More light -> lower photoresistor resistance -> LOWER ADC reading\r\n");

  // One-time calibration at startup: measures and removes the ADC's internal offset.
  // Must run while the ADC is disabled, i.e. before the first conversion.
  if (HAL_ADCEx_Calibration_Start(&hadc1, ADC_SINGLE_ENDED) != HAL_OK)
  {
    uart_print("ERROR: ADC calibration failed\r\n");
  }
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    if (adc_read_avg(&raw) == HAL_OK)
    {
      // Vout ~= (D / 2^n) * Vref, computed in millivolts with integer math
      mv = (raw * VREF_MV) / ADC_FULL_SCALE;
      format_r_ldr(rbuf, sizeof rbuf, raw);
      make_light_bar(bar, raw);
      snprintf(msg, sizeof msg, "ADC = %4u   Vout = %u.%03u V   R_LDR = %s   light |%s|\r\n",
               (unsigned)raw, (unsigned)(mv / 1000), (unsigned)(mv % 1000), rbuf, bar);
      uart_print(msg);
    }
    else
    {
      uart_print("ERROR: ADC conversion failed\r\n");
    }

    HAL_Delay(200);   // about 5 readings per second
  }
  /* USER CODE END 3 */
}

