/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */
  uint8_t key = 0;
  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_ADC1_Init();
  MX_DAC1_Init();
  MX_LPUART1_UART_Init();
  MX_TIM6_Init();
  /* USER CODE BEGIN 2 */
  uart_print("\r\nEE186 Lab 4: DAC waveform generator (TIM6 -> DAC1 via DMA, output on PA4)\r\n");
  print_help();

  // Start on a sine wave at middle C
  load_waveform(WAVE_SINE);
  set_frequency(MIDDLE_C_MHZ);

  // DMA streams wave_buf to the DAC in circular mode: each TIM6 trigger outputs the next
  // sample, and after the last one it wraps back to the first. The CPU is not involved.
  if (HAL_DAC_Start_DMA(&hdac1, DAC_CHANNEL_1, (uint32_t *)wave_buf, N_SAMPLES,
                        DAC_ALIGN_12B_R) != HAL_OK ||
      HAL_TIM_Base_Start(&htim6) != HAL_OK)
  {
    uart_print("ERROR: DAC/DMA/TIM6 start failed\r\n");
  }
  print_status();
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    // The waveform plays entirely in hardware. The loop only checks for a key press in the
    // terminal (non-blocking: a timeout of 0 returns immediately if nothing was typed).
    __HAL_UART_CLEAR_OREFLAG(&hlpuart1);
    if (HAL_UART_Receive(&hlpuart1, &key, 1, 0) == HAL_OK)
    {
      switch (key)
      {
        case '1': load_waveform(WAVE_SINE);     break;
        case '2': load_waveform(WAVE_SQUARE);   break;
        case '3': load_waveform(WAVE_SAWTOOTH); break;
        case '+':
        case '=': set_frequency(current_freq_mhz * 2U); break;   // one octave up
        case '-': set_frequency(current_freq_mhz / 2U); break;   // one octave down
        case 'c':
        case 'C': set_frequency(MIDDLE_C_MHZ);  break;
        default:  print_help();                 break;
      }
      print_status();
    }
    HAL_Delay(10);
  }
  /* USER CODE END 3 */
}

