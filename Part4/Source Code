// Send a null-terminated string to the terminal (ST-LINK virtual COM port)
static void uart_print(const char *s)
{
  HAL_UART_Transmit(&hlpuart1, (uint8_t *)s, (uint16_t)strlen(s), 100);
}

// Fill the playback buffer with one period of the chosen waveform.
// DMA keeps reading this buffer in a loop, so the new shape plays immediately.
static void load_waveform(waveform_t w)
{
  for (uint32_t x = 0; x < N_SAMPLES; x++)
  {
    switch (w)
    {
      case WAVE_SINE:
        wave_buf[x] = SINE_TABLE[x];
        break;
      case WAVE_SQUARE:      // high for the first half of the period, low for the second
        wave_buf[x] = (x < N_SAMPLES / 2) ? (DAC_MID + DAC_AMPL) : (DAC_MID - DAC_AMPL);
        break;
      case WAVE_SAWTOOTH:    // linear ramp from low to high, then drops back
        wave_buf[x] = (uint16_t)(DAC_MID - DAC_AMPL + (2U * DAC_AMPL * x) / (N_SAMPLES - 1));
        break;
    }
  }
  current_wave = w;
}

// changeNote(): generate the current waveform at the given frequency (in milli-Hz,
// e.g. 262000 = 262 Hz) by changing TIM6's period. Called by the scale demo and the theremin.
//   f_out = f_TRGO / N_SAMPLES   (AN3126 Eq. 5),   f_TRGO = f_timer / (ARR + 1)
//   =>  ARR + 1 = f_timer / (f_out * N_SAMPLES)
// TIM6 runs from the APB1 timer clock; with the APB1 prescaler at /1 that equals PCLK1 (80 MHz).
// Auto-reload preload is enabled, so the new period starts cleanly at the next update event.
static void changeNote(uint32_t freq_mhz)
{
  if (freq_mhz < FREQ_MIN_MHZ) freq_mhz = FREQ_MIN_MHZ;
  if (freq_mhz > FREQ_MAX_MHZ) freq_mhz = FREQ_MAX_MHZ;

  uint64_t f_timer_mhz = (uint64_t)HAL_RCC_GetPCLK1Freq() * 1000U;   // timer clock in milli-Hz
  uint64_t denom       = (uint64_t)freq_mhz * N_SAMPLES;
  uint32_t period      = (uint32_t)((f_timer_mhz + denom / 2U) / denom); // ARR + 1, rounded

  if (period < 2U)     period = 2U;
  if (period > 65536U) period = 65536U;
  __HAL_TIM_SET_AUTORELOAD(&htim6, period - 1U);

  current_freq_mhz = freq_mhz;
  actual_freq_mhz  = (uint32_t)(f_timer_mhz / ((uint64_t)period * N_SAMPLES));
}

static void print_help(void)
{
  uart_print("Keys: m = musical (C major notes), g = glide (smooth pitch), s = play scale,\r\n"
             "      r = recalibrate, 1/2/3 = sine/square/sawtooth\r\n");
}

// One ADC conversion on PB1 (ADC1_IN16)
static HAL_StatusTypeDef adc_read(uint32_t *raw)
{
  if (HAL_ADC_Start(&hadc1) != HAL_OK)                 return HAL_ERROR;
  if (HAL_ADC_PollForConversion(&hadc1, 10) != HAL_OK) return HAL_ERROR;
  *raw = HAL_ADC_GetValue(&hadc1);
  return HAL_OK;
}

// Average several conversions to reduce noise
static HAL_StatusTypeDef adc_read_avg(uint32_t *avg)
{
  uint32_t sum = 0, sample = 0;
  for (uint32_t i = 0; i < ADC_AVG_SAMPLES; i++)
  {
    if (adc_read(&sample) != HAL_OK) return HAL_ERROR;
    sum += sample;
  }
  *avg = sum / ADC_AVG_SAMPLES;
  return HAL_OK;
}

// Forget the calibration; the next readings set new bright/dark limits
static void reset_calibration(uint32_t reading)
{
  adc_filt = reading;
  adc_min = reading;
  adc_max = reading;
  current_note = -1;
}

// Play the C major scale C4..C5 once, to verify changeNote() by ear
static void play_scale(void)
{
  char msg[48];
  uart_print("Scale: ");
  for (uint32_t i = 0; i <= 7; i++)
  {
    changeNote(MAJOR_MHZ[i]);
    snprintf(msg, sizeof msg, "%s ", MAJOR_NAMES[i]);
    uart_print(msg);
    HAL_Delay(SCALE_NOTE_MS);
  }
  uart_print("\r\n");
  current_note = -1;               // let the theremin pick its note fresh
}

// Map the smoothed light reading to a frequency (milli-Hz) and a note name.
// Position 0 = brightest seen (lowest pitch), full = darkest seen (highest pitch).
static uint32_t light_to_freq(const char **note_name)
{
  uint32_t span = adc_max - adc_min;
  *note_name = "--";
  if (span < MIN_SPAN)                         // not calibrated yet: hold the lowest note
  {
    return MAJOR_MHZ[0];
  }
  uint32_t offset = (adc_filt > adc_min) ? (adc_filt - adc_min) : 0;
  if (offset > span) offset = span;

  if (mode == MODE_GLIDE)
  {
    // Pitch is perceived logarithmically, so map light linearly to SEMITONES, not Hz.
    // pos is in 1/16-semitone steps; interpolate between neighbouring semitones.
    uint32_t pos  = (offset * N_SEMITONES * 16U) / span;   // 0 .. 384
    uint32_t k    = pos / 16U;
    uint32_t frac = pos % 16U;
    if (k >= N_SEMITONES) return SEMITONE_MHZ[N_SEMITONES];
    return SEMITONE_MHZ[k] + ((SEMITONE_MHZ[k + 1] - SEMITONE_MHZ[k]) * frac) / 16U;
  }

  // Musical mode: snap to the nearest note of the C major scale, with hysteresis so a
  // hand held near a boundary doesn't flicker between two notes.
  uint32_t pos = (offset * N_NOTES * 16U) / (span + 1U);     // 0 .. 239, 16 steps per note
  int32_t  idx = (int32_t)(pos / 16U);
  if (current_note < 0 ||
      (int32_t)pos < current_note * 16 - (int32_t)NOTE_HYST ||
      (int32_t)pos >= (current_note + 1) * 16 + (int32_t)NOTE_HYST)
  {
    current_note = idx;
  }
  if (current_note > (int32_t)N_NOTES - 1) current_note = N_NOTES - 1;
  *note_name = MAJOR_NAMES[current_note];
  return MAJOR_MHZ[current_note];
}
