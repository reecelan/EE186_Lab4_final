/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */
  uint8_t key = 0;
  uint32_t reading = 0;
  uint32_t loops = 0;
  uint32_t freq_mhz = 0;
  const char *note = "--";
  char msg[128];
  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_ADC1_Init();
  MX_DAC1_Init();
  MX_LPUART1_UART_Init();
  MX_TIM6_Init();
  /* USER CODE BEGIN 2 */
  uart_print("\r\nEE186 Lab 4: light theremin (photoresistor on PB1, audio on PA4)\r\n");
  print_help();

  // ADC: one-time calibration before the first conversion
  if (HAL_ADCEx_Calibration_Start(&hadc1, ADC_SINGLE_ENDED) != HAL_OK)
  {
    uart_print("ERROR: ADC calibration failed\r\n");
  }

  // Audio output: sine table streamed to the DAC by DMA, paced by TIM6 (as in the middle C code)
  load_waveform(WAVE_SINE);
  changeNote(MAJOR_MHZ[0]);
  if (HAL_DAC_Start_DMA(&hdac1, DAC_CHANNEL_1, (uint32_t *)wave_buf, N_SAMPLES,
                        DAC_ALIGN_12B_R) != HAL_OK ||
      HAL_TIM_Base_Start(&htim6) != HAL_OK)
  {
    uart_print("ERROR: DAC/DMA/TIM6 start failed\r\n");
  }

  // Verify changeNote() by ear with a scale, then start the theremin
  play_scale();
  if (adc_read_avg(&reading) == HAL_OK)
  {
    reset_calibration(reading);
  }
  uart_print("Wave your hand over the sensor (fully away and fully covering) to calibrate.\r\n");
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    // 1. Read and smooth the light level
    if (adc_read_avg(&reading) == HAL_OK)
    {
      adc_filt = adc_filt + (int32_t)(reading - adc_filt) / (1 << FILTER_SHIFT);
      if (adc_filt < adc_min) adc_min = adc_filt;     // brightest seen so far
      if (adc_filt > adc_max) adc_max = adc_filt;     // darkest seen so far
    }

    // 2. Light level -> pitch
    freq_mhz = light_to_freq(&note);
    changeNote(freq_mhz);

    // 3. Status line about 5 times per second
    if (++loops >= PRINT_EVERY)
    {
      loops = 0;
      uint32_t span = adc_max - adc_min;
      uint32_t pct = (span >= MIN_SPAN) ? ((adc_filt - adc_min) * 100U) / span : 0U;
      snprintf(msg, sizeof msg,
               "%s  ADC = %4u  (range %4u..%4u)  hand %3u%%  ->  %4u.%u Hz  %s\r\n",
               (mode == MODE_GLIDE) ? "glide  " : "musical",
               (unsigned)adc_filt, (unsigned)adc_min, (unsigned)adc_max, (unsigned)pct,
               (unsigned)(actual_freq_mhz / 1000), (unsigned)((actual_freq_mhz % 1000) / 100),
               note);
      uart_print(msg);
    }

    // 4. Keyboard commands from the terminal (non-blocking)
    __HAL_UART_CLEAR_OREFLAG(&hlpuart1);
    if (HAL_UART_Receive(&hlpuart1, &key, 1, 0) == HAL_OK)
    {
      switch (key)
      {
        case 'm': mode = MODE_MUSICAL; current_note = -1; uart_print("Mode: musical\r\n"); break;
        case 'g': mode = MODE_GLIDE;                      uart_print("Mode: glide\r\n");   break;
        case 's': play_scale();                                                             break;
        case 'r': reset_calibration(adc_filt); uart_print("Calibration reset\r\n");         break;
        case '1': load_waveform(WAVE_SINE);     uart_print("Wave: sine\r\n");     break;
        case '2': load_waveform(WAVE_SQUARE);   uart_print("Wave: square\r\n");   break;
        case '3': load_waveform(WAVE_SAWTOOTH); uart_print("Wave: sawtooth\r\n"); break;
        default:  print_help(); break;
      }
    }

    HAL_Delay(LOOP_MS);
  }
  /* USER CODE END 3 */
}

